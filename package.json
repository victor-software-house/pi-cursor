{
	"name": "pi-cursor-inference",
	"version": "0.0.0",
	"description": "Cursor as a plain inference provider for Pi, over aiserver.v1.InferenceService/RunInference.",
	"license": "MIT",
	"author": {
		"name": "Victor Araújo",
		"email": "victor@victor-software-house.com"
	},
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"pi": {
		"extensions": [
			"./dist/index.mjs"
		]
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
		"prepublishOnly": "mise run verify"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "bun@1.4.0",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24"
		},
		"packageManager": {
			"name": "bun",
			"version": ">=1.4.0 <2.0.0"
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/victor-software-house/pi-cursor.git"
	},
	"homepage": "https://github.com/victor-software-house/pi-cursor#readme",
	"bugs": {
		"url": "https://github.com/victor-software-house/pi-cursor/issues"
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"cursor",
		"provider",
		"inference"
	],
	"peerDependencies": {
		"@earendil-works/pi-ai": ">=0.84.4",
		"@earendil-works/pi-coding-agent": ">=0.84.4",
		"@earendil-works/pi-tui": ">=0.84.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@bufbuild/protobuf": "2.14.1",
		"@bufbuild/protoc-gen-es": "2.14.1",
		"@changesets/cli": "3.0.1",
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"@earendil-works/pi-ai": "0.84.4",
		"@earendil-works/pi-coding-agent": "0.84.4",
		"@earendil-works/pi-tui": "0.84.4",
		"@types/bun": "1.4.0",
		"@types/node": "26.4.0",
		"bun-release": "0.0.3",
		"oxlint": "1.80.0",
		"oxlint-tsgolint": "7.0.2001",
		"publint": "0.3.22",
		"tsdown": "0.22.14",
		"typescript": "7.0.2"
	}
}
